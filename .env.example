DATABASE_URL=postgresql://fiscal_reader:local_reader@localhost:5432/fiscal
# Local-only writer used by the review workspace. Never configure this in Vercel.
REVIEW_DATABASE_URL=postgresql://fiscal_reviewer:local_reviewer@localhost:5432/fiscal
REVIEW_MODE=local
INGEST_DATABASE_URL=postgresql+psycopg://fiscal:local_dev_only@localhost:5432/fiscal
MIGRATION_DATABASE_URL=postgresql+psycopg://fiscal:local_dev_only@localhost:5432/fiscal
ARCHIVE_DIR=archive
INGEST_ENV=local
OPENAI_MODEL=
# Optional local ingestion key. Keep real values only in the ignored .env file.
# Setup never triggers paid calls.
OPENAI_API_KEY=
# Private Cloudflare R2 source-PDF archive. Required only for `download --store-r2`.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIX=filings
