{
  "openapi": "3.1.0",
  "info": {
    "title": "Fiscal review API",
    "version": "1.0.0",
    "description": "Public read-only API. API version and dataset identity are separate. All monetary values remain decimal strings. Unknown or repeated query keys are rejected; query collection sizes are bounded. Only published, verified payloads are returned. Empty company publications produce NO_PUBLISHED_DATASET, not synthetic values."
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Database readiness, without credentials",
        "responses": {
          "200": {
            "description": "Successful read",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ready"
                    },
                    "requestId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query or missing pinned version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Company, publication or statement unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable or stored publication invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/companies": {
      "get": {
        "summary": "Configured company collection (maximum 100)",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful read",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Company"
                      }
                    },
                    "requestId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query or missing pinned version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Company, publication or statement unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable or stored publication invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/companies/{id}/statements": {
      "get": {
        "summary": "Immutable published statement; latest active dataset unless version is supplied",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,100}$"
            }
          },
          {
            "name": "version",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          {
            "name": "statement",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["income", "balance", "cashflow"],
              "default": "income"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(19|20)\\d{2}$"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(19|20)\\d{2}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful read",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "datasetVersion",
                    "statement",
                    "coverage",
                    "requestId"
                  ],
                  "properties": {
                    "datasetVersion": {
                      "type": "string"
                    },
                    "statement": {
                      "$ref": "#/components/schemas/Statement"
                    },
                    "coverage": {
                      "$ref": "#/components/schemas/Coverage"
                    },
                    "requestId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query or missing pinned version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Company, publication or statement unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable or stored publication invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/companies/{id}/filings": {
      "get": {
        "summary": "Filing metadata with cursor pagination (discovery is not verification)",
        "parameters": [
          {
            "name": "download",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["manifest"] },
            "description": "Download the filtered page as a source manifest JSON attachment; nextCursor identifies further pages."
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,100}$"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "classification",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "year",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(19|20)\\d{2}$"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful read",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Filing"
                      }
                    },
                    "nextCursor": {
                      "type": ["string", "null"]
                    },
                    "requestId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query or missing pinned version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Company, publication or statement unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable or stored publication invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/companies/{id}/quality": {
      "get": {
        "summary": "Coverage and recorded validation for a published version",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,100}$"
            }
          },
          {
            "name": "version",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful read",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "datasetVersion": {
                      "type": "string"
                    },
                    "coverage": {
                      "$ref": "#/components/schemas/Coverage"
                    },
                    "validation": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "requestId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query or missing pinned version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Company, publication or statement unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable or stored publication invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/observations/{observationId}/history": {
      "get": {
        "summary": "Chosen evidence and compatible alternative observations found in at most 100 published datasets",
        "description": "Unpublished candidate extractions are private. Dataset hash ordering is not publication precedence. Version and company are mandatory.",
        "parameters": [
          {
            "name": "observationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "company",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,100}$"
            }
          },
          {
            "name": "version",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful read",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "datasetVersion": {
                      "type": "string"
                    },
                    "selected": {
                      "$ref": "#/components/schemas/Cell"
                    },
                    "period": {
                      "$ref": "#/components/schemas/Period"
                    },
                    "row": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "aliases": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "units": {
                      "type": "object",
                      "properties": {
                        "currency": {
                          "type": "string"
                        },
                        "unit": {
                          "type": "string"
                        },
                        "basis": {
                          "type": "string"
                        },
                        "scope": {
                          "type": "string"
                        }
                      }
                    },
                    "source": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/Filing"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "previousObservations": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "datasetVersion": {
                            "type": "string"
                          },
                          "cell": {
                            "$ref": "#/components/schemas/Cell"
                          },
                          "period": {
                            "$ref": "#/components/schemas/Period"
                          },
                          "currency": {
                            "type": "string"
                          },
                          "unit": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "historyStatus": {
                      "type": "string"
                    },
                    "requestId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query or missing pinned version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Company, publication or statement unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable or stored publication invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/companies/{id}/export": {
      "get": {
        "summary": "CSV matching a pinned published version",
        "description": "Decimal strings are never converted to floating point. Row-level units and evidence references are included. Text starting with spreadsheet formula characters is prefixed with an apostrophe.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,100}$"
            }
          },
          {
            "name": "version",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          {
            "name": "statement",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["income", "balance", "cashflow"],
              "default": "income"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "historical",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["true", "false"],
              "default": "false"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(19|20)\\d{2}$"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(19|20)\\d{2}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Statement CSV",
            "headers": {
              "X-Dataset-Version": {
                "schema": {
                  "type": "string"
                }
              },
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query or missing pinned version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Company, publication or statement unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable or stored publication invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "requestId"],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      },
      "Company": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "fiscal_year_end_month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          }
        }
      },
      "Filing": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "classification": {
            "type": "string"
          },
          "published_on": {
            "type": ["string", "null"],
            "format": "date"
          },
          "sha256": {
            "type": "string"
          }
        }
      },
      "Coverage": {
        "type": "object",
        "required": ["expectedPeriods", "verifiedPeriods", "gaps"],
        "properties": {
          "expectedPeriods": {
            "type": "integer",
            "minimum": 0
          },
          "verifiedPeriods": {
            "type": "integer",
            "minimum": 0
          },
          "gaps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Period": {
        "type": "object",
        "required": ["id", "label", "start", "end"],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "start": {
            "type": ["string", "null"],
            "format": "date"
          },
          "end": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "Cell": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "state",
          "observationId",
          "filingId",
          "rawLabel",
          "rawText",
          "pdfPage",
          "printedPage",
          "comparative"
        ],
        "properties": {
          "value": {
            "type": ["string", "null"],
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "description": "Exact decimal string; null only for non-reported states"
          },
          "state": {
            "type": "string",
            "enum": ["reported", "not_reported", "unreadable"]
          },
          "observationId": {
            "type": "string"
          },
          "filingId": {
            "type": "string"
          },
          "rawLabel": {
            "type": "string"
          },
          "rawText": {
            "type": "string"
          },
          "pdfPage": {
            "type": "integer",
            "minimum": 1
          },
          "printedPage": {
            "type": "string"
          },
          "comparative": {
            "type": "string",
            "enum": ["original", "updated", "restated"]
          }
        }
      },
      "Statement": {
        "type": "object",
        "required": [
          "id",
          "title",
          "scope",
          "basis",
          "currency",
          "unit",
          "periods",
          "rows"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": ["income", "balance", "cashflow"]
          },
          "title": {
            "type": "string"
          },
          "scope": {
            "const": "consolidated"
          },
          "basis": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "unit": {
            "type": "string"
          },
          "periods": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/Period"
            }
          },
          "rows": {
            "type": "array",
            "maxItems": 5000,
            "items": {
              "$ref": "#/components/schemas/Row"
            }
          }
        }
      },
      "Row": {
        "type": "object",
        "required": [
          "id",
          "label",
          "currency",
          "unit",
          "aliases",
          "depth",
          "kind",
          "historical",
          "cells"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "unit": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "depth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "kind": {
            "type": "string",
            "enum": ["item", "subtotal", "section"]
          },
          "historical": {
            "type": "boolean"
          },
          "cells": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/Cell"
            }
          }
        }
      }
    }
  }
}
